generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id              String             @id @default(uuid())
  name            String
  phone           String?            @unique
  balance         Int                @default(0)
  createdAt       DateTime           @default(now())
  intents         AttendanceIntent[]
  actuals         AttendanceActual[]
  txs             Transaction[]
  settlements     Settlement[]
  customAttendees CustomAttendee[]
  kitItems        KitOrderItem[]
}

model Match {
  id              String             @id @default(uuid())
  dateTime        DateTime
  type            MatchType
  status          MatchStatus
  fieldCost       Int                @default(600000)
  link            String
  qrCodeRef       String
  createdAt       DateTime           @default(now())
  intents         AttendanceIntent[]
  actuals         AttendanceActual[]
  txs             Transaction[]
  settlements     Settlement[]
  customAttendees CustomAttendee[]
}

enum MatchType {
  Internal
  VsTeam
}

enum MatchStatus {
  Draft
  Collecting
  Ready
  NotReady
  Settled
}

model AttendanceIntent {
  id         String           @id @default(uuid())
  matchId    String
  playerId   String
  status     AttendanceStatus
  isLate     Boolean          @default(false)
  note       String?
  guestCount Int              @default(0)
  createdAt  DateTime         @default(now())
  match      Match            @relation(fields: [matchId], references: [id])
  player     Player           @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

enum AttendanceStatus {
  Attending
  Tentative
  NotGoing
}

model AttendanceActual {
  id             String   @id @default(uuid())
  matchId        String
  playerId       String
  memberAttended Boolean  @default(false)
  guestsAttended Int      @default(0)
  createdAt      DateTime @default(now())
  /// Last time an organizer saved this row from the settlement page
  updatedAt      DateTime @default(now()) @updatedAt
  match          Match    @relation(fields: [matchId], references: [id])
  player         Player   @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

model Transaction {
  id        String          @id @default(uuid())
  playerId  String
  matchId   String?
  type      TransactionType
  amount    Int
  note      String?
  createdAt DateTime        @default(now())
  player    Player          @relation(fields: [playerId], references: [id])
  match     Match?          @relation(fields: [matchId], references: [id])
}

model Settlement {
  id        String          @id @default(uuid())
  matchId   String
  playerId  String?
  customId  String?
  amount    Int
  paid      Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  match     Match           @relation(fields: [matchId], references: [id])
  player    Player?         @relation(fields: [playerId], references: [id])
  custom    CustomAttendee? @relation(fields: [customId], references: [id])

  @@unique([matchId, playerId])
  @@unique([matchId, customId])
}

model CustomAttendee {
  id          String       @id @default(uuid())
  matchId     String
  name        String
  guestCount  Int          @default(0)
  playerId    String? // Optional: for existing players added to custom list
  createdAt   DateTime     @default(now())
  match       Match        @relation(fields: [matchId], references: [id])
  player      Player?      @relation(fields: [playerId], references: [id])
  settlements Settlement[]
}

enum TransactionType {
  TopUp
  Charge
  Refund
}

model PendingRosterRequest {
  id        String              @id @default(uuid())
  name      String
  phone     String?
  deviceId  String?
  createdAt DateTime            @default(now())
  status    RosterRequestStatus
}

enum RosterRequestStatus {
  Pending
  Approved
  Rejected
}

/// Một đợt làm áo đội. Tiền thu áo tách biệt hoàn toàn với quỹ (không tạo Transaction).
model KitOrder {
  id             String          @id @default(uuid())
  name           String
  description    String?
  /// Giá mặc định cho một áo (mua áo + in)
  defaultPrice   Int
  /// Giá khi chỉ in (tự mang áo); null = không nhận chỉ in
  printOnlyPrice Int?
  deadline       DateTime?
  status         KitOrderStatus  @default(Collecting)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          KitOrderItem[]
  images         KitOrderImage[]
}

/// Ảnh của đợt áo: nhiều ảnh minh hoạ, tối đa một bảng size.
/// Lưu thẳng trong DB (đã thu nhỏ ở trình duyệt) để không cần dịch vụ lưu file.
model KitOrderImage {
  id         String       @id @default(uuid())
  kitOrderId String
  kind       KitImageKind
  mimeType   String
  data       Bytes
  /// Thứ tự hiển thị ảnh minh hoạ, organizer kéo thả để đổi
  position   Int          @default(0)
  createdAt  DateTime     @default(now())
  kitOrder   KitOrder     @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)

  @@index([kitOrderId])
}

enum KitImageKind {
  Preview
  SizeChart
}

enum KitOrderStatus {
  Collecting
  Ordered
  Delivered
}

/// Một áo trong đợt. Mỗi cầu thủ đăng ký tối đa một áo mỗi đợt.
model KitOrderItem {
  id              String    @id @default(uuid())
  kitOrderId      String
  /// Cầu thủ đăng ký; null nếu organizer thêm cho người ngoài
  playerId        String?
  guestName       String?
  /// null khi chỉ in (tự mang áo)
  size            KitSize?
  /// Bắt buộc khi size = Other
  sizeNote        String?
  printName       String?
  number          Int?
  printOnly       Boolean   @default(false)
  amount          Int
  /// Organizer đã đặt giá riêng: đổi giá đợt sẽ không ghi đè dòng này
  priceOverridden Boolean   @default(false)
  paid            Boolean   @default(false)
  paidAt          DateTime?
  /// Cầu thủ bấm "Tôi đã chuyển khoản", chờ organizer xác nhận
  selfReportedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  kitOrder        KitOrder  @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)
  player          Player?   @relation(fields: [playerId], references: [id])

  @@unique([kitOrderId, playerId])
  @@index([kitOrderId])
}

enum KitSize {
  S
  M
  L
  XL
  XXL
  Other
}
