generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id              String             @id @default(uuid())
  name            String
  phone           String?            @unique
  balance         Int                @default(0)
  createdAt       DateTime           @default(now())
  intents         AttendanceIntent[]
  actuals         AttendanceActual[]
  txs             Transaction[]
  settlements     Settlement[]
  customAttendees CustomAttendee[]
  kitItems        KitOrderItem[]
  zaloAccount     ZaloAccount?
}

model Match {
  id              String             @id @default(uuid())
  dateTime        DateTime
  type            MatchType
  status          MatchStatus
  fieldCost       Int                @default(600000)
  link            String
  qrCodeRef       String
  createdAt       DateTime           @default(now())
  intents         AttendanceIntent[]
  actuals         AttendanceActual[]
  txs             Transaction[]
  settlements     Settlement[]
  customAttendees CustomAttendee[]
}

enum MatchType {
  Internal
  VsTeam
}

enum MatchStatus {
  Draft
  Collecting
  Ready
  NotReady
  Settled
}

model AttendanceIntent {
  id         String           @id @default(uuid())
  matchId    String
  playerId   String
  status     AttendanceStatus
  isLate     Boolean          @default(false)
  note       String?
  guestCount Int              @default(0)
  createdAt  DateTime         @default(now())
  match      Match            @relation(fields: [matchId], references: [id])
  player     Player           @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

enum AttendanceStatus {
  Attending
  Tentative
  NotGoing
}

model AttendanceActual {
  id             String   @id @default(uuid())
  matchId        String
  playerId       String
  memberAttended Boolean  @default(false)
  guestsAttended Int      @default(0)
  createdAt      DateTime @default(now())
  /// Last time an organizer saved this row from the settlement page
  updatedAt      DateTime @default(now()) @updatedAt
  match          Match    @relation(fields: [matchId], references: [id])
  player         Player   @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

model Transaction {
  id        String          @id @default(uuid())
  playerId  String
  matchId   String?
  type      TransactionType
  amount    Int
  note      String?
  createdAt DateTime        @default(now())
  player    Player          @relation(fields: [playerId], references: [id])
  match     Match?          @relation(fields: [matchId], references: [id])
}

model Settlement {
  id        String          @id @default(uuid())
  matchId   String
  playerId  String?
  customId  String?
  amount    Int
  paid      Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  match     Match           @relation(fields: [matchId], references: [id])
  player    Player?         @relation(fields: [playerId], references: [id])
  custom    CustomAttendee? @relation(fields: [customId], references: [id])

  @@unique([matchId, playerId])
  @@unique([matchId, customId])
}

model CustomAttendee {
  id          String       @id @default(uuid())
  matchId     String
  name        String
  guestCount  Int          @default(0)
  playerId    String? // Optional: for existing players added to custom list
  createdAt   DateTime     @default(now())
  match       Match        @relation(fields: [matchId], references: [id])
  player      Player?      @relation(fields: [playerId], references: [id])
  settlements Settlement[]
}

enum TransactionType {
  TopUp
  Charge
  Refund
}

model PendingRosterRequest {
  id        String              @id @default(uuid())
  name      String
  phone     String?
  deviceId  String?
  createdAt DateTime            @default(now())
  status    RosterRequestStatus
}

enum RosterRequestStatus {
  Pending
  Approved
  Rejected
}

/// Một đợt làm áo đội. Tiền thu áo tách biệt hoàn toàn với quỹ (không tạo Transaction).
model KitOrder {
  id             String          @id @default(uuid())
  name           String
  description    String?
  /// Giá mặc định cho một áo (mua áo + in)
  defaultPrice   Int
  /// Giá khi chỉ in (tự mang áo); null = không nhận chỉ in
  printOnlyPrice Int?
  deadline       DateTime?
  status         KitOrderStatus  @default(Collecting)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          KitOrderItem[]
  images         KitOrderImage[]
}

/// Ảnh của đợt áo: nhiều ảnh minh hoạ, tối đa một bảng size.
/// Lưu thẳng trong DB (đã thu nhỏ ở trình duyệt) để không cần dịch vụ lưu file.
model KitOrderImage {
  id         String       @id @default(uuid())
  kitOrderId String
  kind       KitImageKind
  mimeType   String
  data       Bytes
  /// Thứ tự hiển thị ảnh minh hoạ, organizer kéo thả để đổi
  position   Int          @default(0)
  createdAt  DateTime     @default(now())
  kitOrder   KitOrder     @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)

  @@index([kitOrderId])
}

enum KitImageKind {
  Preview
  SizeChart
}

enum KitOrderStatus {
  Collecting
  Ordered
  Delivered
}

/// Một áo trong đợt. Mỗi cầu thủ đăng ký tối đa một áo mỗi đợt.
model KitOrderItem {
  id              String    @id @default(uuid())
  kitOrderId      String
  /// Cầu thủ đăng ký; null nếu organizer thêm cho người ngoài
  playerId        String?
  guestName       String?
  /// null khi chỉ in (tự mang áo)
  size            KitSize?
  /// Bắt buộc khi size = Other
  sizeNote        String?
  printName       String?
  number          Int?
  printOnly       Boolean   @default(false)
  amount          Int
  /// Organizer đã đặt giá riêng: đổi giá đợt sẽ không ghi đè dòng này
  priceOverridden Boolean   @default(false)
  paid            Boolean   @default(false)
  paidAt          DateTime?
  /// Cầu thủ bấm "Tôi đã chuyển khoản", chờ organizer xác nhận
  selfReportedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  kitOrder        KitOrder  @relation(fields: [kitOrderId], references: [id], onDelete: Cascade)
  player          Player?   @relation(fields: [playerId], references: [id])

  @@unique([kitOrderId, playerId])
  @@index([kitOrderId])
}

enum KitSize {
  S
  M
  L
  XL
  XXL
  Other
}

/// Tài khoản Zalo đã nhắn với bot. Id do Zalo cấp riêng cho từng bot,
/// dùng được cả để nhận diện trong nhóm lẫn để nhắn riêng.
model ZaloAccount {
  zaloUserId  String    @id
  displayName String
  /// Liên kết với cầu thủ sau khi người dùng nhắn đúng số điện thoại
  playerId    String?   @unique
  /// Được dùng lệnh organizer qua bot
  isAdmin     Boolean   @default(false)
  linkedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

/// Một lượt bot xử lý tin nhắn. message_id của Zalo làm khoá chính nên
/// tin gửi lại sẽ bị bỏ qua. Dùng luôn làm bộ nhớ hội thoại, đếm tần suất
/// và log (công cụ đã gọi, token, thời gian, lỗi).
model ZaloTurn {
  messageId    String   @id
  zaloUserId   String
  chatId       String
  chatType     String
  text         String
  reply        String?
  steps        Json?
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  error        String?
  createdAt    DateTime @default(now())

  @@index([zaloUserId, chatId, createdAt])
}

/// Thao tác ghi đang chờ người dùng trả lời "ok" (VD admin đánh dấu đã thu).
/// Mỗi người, mỗi cuộc chat chỉ có một thao tác chờ.
model ZaloPendingAction {
  id         String   @id @default(uuid())
  zaloUserId String
  chatId     String
  kind       String
  payload    Json
  summary    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([zaloUserId, chatId])
}

/// Nhóm Zalo có bot. notify = nhận thông báo trận mới, nhắc điểm danh.
model ZaloGroup {
  chatId     String   @id
  notify     Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt
}

/// Thông báo đã gửi, để cron và các lần gọi lại không gửi trùng
model ZaloNotification {
  id        String   @id @default(uuid())
  kind      String
  /// matchId hoặc settlementId tuỳ loại
  refId     String
  chatId    String
  createdAt DateTime @default(now())

  @@unique([kind, refId, chatId])
}
